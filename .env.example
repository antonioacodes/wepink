HOST=127.0.0.1
PORT=3000
PUBLIC_ORIGIN=http://127.0.0.1:3000
DATA_DIR=./data
# Generate with npm run admin:password. Never use an unhashed password here.
ADMIN_PASSWORD_HASH=
